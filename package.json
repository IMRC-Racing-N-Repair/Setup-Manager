    "prebuild:ios:clean": "expo prebuild --platform ios --clean",
    "clean:generated": "node scripts/cleanGenerated.mjs",
    "build:ios:clean": "npm run clean:generated && npm ci && npm run doctor && npx eas-cli build --platform ios --profile production --clear-cache"
