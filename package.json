  "main": "./index.js",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
